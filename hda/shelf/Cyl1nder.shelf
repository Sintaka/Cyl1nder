<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- Cyl1nder shelf: hot-reload tools for the Houdini <-> WebGL bridge.
       Install: copy this file to %USERPROFILE%\Documents\houdini22.0\toolbar\
       (new buttons appear on next Houdini start / shelf refresh; the tool
       scripts exec() files from disk on click, so their logic is hot-reload). -->
  <toolshelf name="Cyl1nder" label="Cyl1nder">
    <memberTool name="cyl1nder::reload_hda"/>
    <memberTool name="cyl1nder::reload_bridge"/>
    <memberTool name="cyl1nder::toggle_bridge"/>
    <memberTool name="cyl1nder::status_bridge"/>
  </toolshelf>

  <tool name="cyl1nder::reload_hda" label="Reload HDA" icon="MISC_python">
    <helpText><![CDATA[Hot-reload Cyl1nder: reload hda/src modules + force recook all instances. No Houdini restart.
For definition-level reload (network/parms/buttons) use reload_cyl1nder(definition=True) in the Python Shell.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou
exec(open(r"D:/code/dev/Cyl1nder/hda/scripts/reload_hda.py").read())
reload_cyl1nder()
hou.ui.displayMessage("Cyl1nder HDA reloaded", title="Cyl1nder")
]]></script>
  </tool>

  <tool name="cyl1nder::reload_bridge" label="Reload Bridge" icon="MISC_python">
    <helpText><![CDATA[Restart the Cyl1nder bridge process (127.0.0.1:8375). Pure Python (netstat/taskkill + Popen), no PowerShell.
HDA keeps working offline; next recook re-pushes inputs.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou
exec(open(r"D:/code/dev/Cyl1nder/hda/scripts/bridge_control.py", encoding="utf-8").read())
hou.ui.displayMessage(restart_bridge(), title="Cyl1nder Bridge")
]]></script>
  </tool>

  <tool name="cyl1nder::toggle_bridge" label="Toggle Bridge" icon="MISC_python">
    <helpText><![CDATA[Start the bridge if it is offline, stop it if it is online (127.0.0.1:8375). Pure Python.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou
exec(open(r"D:/code/dev/Cyl1nder/hda/scripts/bridge_control.py", encoding="utf-8").read())
hou.ui.displayMessage(toggle_bridge(), title="Cyl1nder Bridge")
]]></script>
  </tool>

  <tool name="cyl1nder::status_bridge" label="Status Bridge" icon="MISC_python">
    <helpText><![CDATA[Show bridge status: /api/health version + serial count, or offline / port-occupied report. Pure Python.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou
exec(open(r"D:/code/dev/Cyl1nder/hda/scripts/bridge_control.py", encoding="utf-8").read())
hou.ui.displayMessage(status_bridge(), title="Cyl1nder Bridge")
]]></script>
  </tool>
</shelfDocument>
